# Sherlock — staging environment (EXAMPLE, placeholders only).
#
# Staging mirrors production but points at a SEPARATE GitHub App, Supabase
# project, and Redis so tests never touch production data. Deploy with:
#   cp .env.staging.example .env.staging      # then fill in real values
#   docker compose --env-file .env.staging -f docker-compose.prod.yml up -d --build
# .env.staging is gitignored and must never be committed.
#
# The --env-file flag is REQUIRED, not cosmetic: it feeds the "Compose host
# settings" below into ${...} interpolation in docker-compose.prod.yml.
# Without it, SHERLOCK_ENV_FILE and SHERLOCK_PRIVATE_KEY_FILE fall back to
# their production defaults — staging would load .env.production into the
# containers and mount the PRODUCTION GitHub App private key.

# --- GitHub App (staging app, separate from production) -------------------
APP_ID=000000
PRIVATE_KEY_PATH=/run/secrets/github_app_private_key
WEBHOOK_SECRET=example-staging-webhook-secret
# If the staging host is not publicly reachable, relay webhooks via a smee.io
# channel instead of a public URL. Leave BLANK once staging has a real URL.
WEBHOOK_PROXY_URL=https://smee.io/your-staging-channel

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=placeholder-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-5

# --- Redis (separate instance / logical DB from production) ---------------
REDIS_URL=redis://redis:6379

# --- State store (separate Supabase project from production) --------------
SHERLOCK_STATE_STORE=supabase
SUPABASE_URL=https://example-staging.supabase.co
SUPABASE_SERVICE_ROLE_KEY=redact-me

# --- Sandbox policy -------------------------------------------------------
SHERLOCK_SANDBOX_NETWORK_POLICY=strict

# --- Artifact retention (same privacy-safe defaults as production) -------
# SHERLOCK_SUCCESSFUL_ARTIFACT_RETENTION_HOURS=0
# SHERLOCK_FAILED_ARTIFACT_RETENTION_HOURS=168
# SHERLOCK_ARTIFACT_CLEANUP_INTERVAL_MINUTES=60
# SHERLOCK_ARTIFACT_CLEANUP_ON_STARTUP=true
# SHERLOCK_ARTIFACT_CLEANUP_MAX_DIRECTORIES=250

# Operational visibility (heartbeat interval < max age < TTL).
# SHERLOCK_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
# SHERLOCK_WORKER_HEARTBEAT_MAX_AGE_SECONDS=45
# SHERLOCK_WORKER_HEARTBEAT_TTL_SECONDS=60
# SHERLOCK_QUEUE_MAX_WAIT_AGE_SECONDS=600
# SHERLOCK_DISK_WARNING_PERCENT=80
# SHERLOCK_DISK_CRITICAL_PERCENT=90
# SHERLOCK_CLEANUP_STATUS_MAX_AGE_MINUTES=180
# SHERLOCK_OPS_REQUEST_TIMEOUT_SECONDS=5
# SHERLOCK_DOCKER_STORAGE_PATH=/host-docker-storage

# --- Staging-only debugging ------------------------------------------------
# Allow the synchronous HTTP investigation endpoint (disabled in production).
# Enable ONLY for controlled staging debugging; never on production.
# ALLOW_SYNC_INVESTIGATIONS=true

# --- Compose host settings (interpolation; need --env-file, see header) ----
# Both of these MUST stay set in staging so the compose defaults (production
# env file, production key path) are never used.
SHERLOCK_ENV_FILE=.env.staging
SHERLOCK_PRIVATE_KEY_FILE=./secrets/github-app-staging-private-key.pem
# API_WEBHOOK_PORT=3000
# SHERLOCK_HOST_TMP=/var/tmp/sherlock
# SHERLOCK_DOCKER_LOG_MAX_SIZE=10m
# SHERLOCK_DOCKER_LOG_MAX_FILES=3
