# Sherlock — production environment (EXAMPLE, placeholders only).
#
# Copy to .env.production on the deploy host and fill in real values:
#   cp .env.production.example .env.production
# .env.production is gitignored and must never be committed. Values here are
# placeholders, not real credentials.
#
# This single file serves TWO roles, so always hand it to Compose itself:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#   1. env_file: injects these variables into BOTH the api and worker
#      containers (variables only one service reads are harmless to the other).
#   2. --env-file makes the "Compose host settings" at the bottom available to
#      ${...} interpolation in docker-compose.prod.yml (ports, volume paths,
#      the private-key path). env_file alone does NOT do that.
# docker-compose.prod.yml sets NODE_ENV, SHERLOCK_RUN_STARTUP_CHECKS, TMPDIR,
# and SHERLOCK_SANDBOX_NETWORK itself, so they are omitted here.

# --- GitHub App (api + worker) --------------------------------------------
# Numeric App ID from the GitHub App settings page.
APP_ID=000000

# GitHub App private key. Recommended: mount the .pem as a Docker secret and
# point PRIVATE_KEY_PATH at it (docker-compose.prod.yml mounts it here).
PRIVATE_KEY_PATH=/run/secrets/github_app_private_key
# Alternative to PRIVATE_KEY_PATH: inline single-line key with \n for newlines.
# Set exactly one of PRIVATE_KEY_PATH or PRIVATE_KEY.
# PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nreplace-with-your-key\n-----END RSA PRIVATE KEY-----

# Webhook signature secret; must match the GitHub App's webhook secret.
WEBHOOK_SECRET=example-webhook-secret

# Local development only (smee.io relay). Leave BLANK in production: GitHub
# delivers webhooks directly to your public URL.
WEBHOOK_PROXY_URL=

# --- Anthropic (api enqueues; worker runs the pipeline) -------------------
ANTHROPIC_API_KEY=placeholder-anthropic-key
# Optional model override (defaults to the app's built-in model when unset).
ANTHROPIC_MODEL=claude-sonnet-5
# Optional phase-specific overrides. Agentic reproduce/fix phases continue to
# use ANTHROPIC_MODEL; set these only after representative quality evaluation.
# SHERLOCK_PLAN_MODEL=claude-sonnet-5
# SHERLOCK_REGRESSION_MODEL=claude-sonnet-5

# --- Redis / queue (api + worker) -----------------------------------------
# Bundled compose Redis. For managed Redis, set the provider endpoint here
# (e.g. rediss://:password@host:6379) and drop the compose redis service.
REDIS_URL=redis://redis:6379

# --- Investigation state store (worker; dashboard reads later) ------------
# Durable per-investigation lifecycle summary. Use `supabase` for production;
# `file` for local JSON; unset for a no-op that records nothing.
SHERLOCK_STATE_STORE=supabase
SUPABASE_URL=https://example.supabase.co
# Backend-only service role key — used ONLY for trusted backend persistence
# (state store, replay evidence, product tables). NEVER expose to client or
# browser code, and never use it to verify user tokens.
SUPABASE_SERVICE_ROLE_KEY=redact-me
# Optional table override (defaults to investigation_states).
# SHERLOCK_STATE_STORE_TABLE=investigation_states

# --- Product API: dashboard auth + GitHub App onboarding (api) -------------
# Supabase publishable key: used ONLY to verify Supabase user access tokens
# (supabase.auth.getUser). Safe for clients by design, but the backend needs
# it separately from the service role key. Same Supabase project as above.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Single trusted frontend origin. The GitHub App setup callback redirects
# ONLY to this origin (/dashboard, /onboarding). Absolute URL, https in
# production, no path/query/credentials.
SHERLOCK_FRONTEND_URL=https://getsherlock.dev
# GitHub App URL slug (the name as it appears in the App's URL,
# https://github.com/apps/<slug>) — NOT the display name.
GITHUB_APP_SLUG=example-app-slug

# --- Replay evidence public upload policy (worker) -------------------------
# Replay media is always recorded locally; UPLOADING it to the public
# Supabase bucket is opt-in. Modes: disabled (default; anything invalid also
# falls back to disabled) or allowlist (upload only exact "owner/repo"
# matches from the comma-separated allowlist; no wildcards). Intended only
# for explicitly approved Sherlock-controlled demo repositories.
SHERLOCK_PUBLIC_REPLAY_UPLOAD_MODE=disabled
SHERLOCK_PUBLIC_REPLAY_ALLOWLIST=

# --- Sandbox policy (worker) ----------------------------------------------
# Target-container outbound network policy: `strict` (secure default, no
# egress) or `permissive`. Keep `strict` in production.
SHERLOCK_SANDBOX_NETWORK_POLICY=strict

# Run the worker preflight at startup and refuse to consume jobs on a broken
# host. docker-compose.prod.yml already sets this for the worker; keep it here
# for running the worker outside compose.
SHERLOCK_RUN_STARTUP_CHECKS=true

# --- Optional tuning (worker) ---------------------------------------------
# Simultaneous jobs in THIS worker process. Scale by adding worker replicas
# and/or raising this; size to host CPU/RAM and Docker capacity.
# INVESTIGATION_WORKER_CONCURRENCY=1
# Base image for target sandboxes (must be pullable on the worker host).
# SHERLOCK_TARGET_IMAGE=node:20-slim
# uid/gid the root worker chowns runtime workspaces to, so the target
# container's unprivileged user can write /app on a Linux daemon. Change only
# if SHERLOCK_TARGET_IMAGE uses a user other than node (1000:1000).
# SHERLOCK_TARGET_UID=1000
# SHERLOCK_TARGET_GID=1000

# Temporary agent-observation mode. These are OFF by default. When enabled,
# every job on this worker skips memory/one-shot reproduction and the fixer
# must complete N successful inspection calls before propose_patch. Use only
# for controlled testing; it intentionally increases model/tool usage.
# SHERLOCK_FORCE_REPRODUCER_AGENT=false
# SHERLOCK_FIXER_MIN_INSPECTIONS=0

# Investigation artifacts are retained for agent memory and replay. Sherlock
# does not automatically delete them; provision durable storage accordingly.

# Operational visibility. Keep heartbeat interval < max age < TTL. Queue age
# warns, while critical required-filesystem usage fails the production check.
# SHERLOCK_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
# SHERLOCK_WORKER_HEARTBEAT_MAX_AGE_SECONDS=45
# SHERLOCK_WORKER_HEARTBEAT_TTL_SECONDS=60
# SHERLOCK_QUEUE_MAX_WAIT_AGE_SECONDS=600
# SHERLOCK_DISK_WARNING_PERCENT=80
# SHERLOCK_DISK_CRITICAL_PERCENT=90
# SHERLOCK_OPS_REQUEST_TIMEOUT_SECONDS=5
# Optional: mount a trustworthy host Docker storage path read-only into the
# worker and configure its in-container path. Otherwise it reports unavailable.
# SHERLOCK_DOCKER_STORAGE_PATH=/host-docker-storage

# --- Compose host settings (read by docker-compose.prod.yml, not the app) --
# These take effect ONLY when this file is passed via
# `docker compose --env-file .env.production ...` (see header).
# Which env file `env_file:` loads into the containers; keep it pointing at
# this file so both roles stay in sync.
SHERLOCK_ENV_FILE=.env.production
# Public port the reverse proxy forwards GitHub webhooks to.
# API_WEBHOOK_PORT=3000
# Host path for the worker clone/temp dir; MUST be identical on host and in the
# container (Docker-outside-of-Docker sibling mounts). Default: /var/tmp/sherlock
# SHERLOCK_HOST_TMP=/var/tmp/sherlock
# Path to the GitHub App .pem on the host, mounted as a Docker secret.
# SHERLOCK_PRIVATE_KEY_FILE=./secrets/github-app-private-key.pem
# Bounded json-file logs for api, worker, and bundled Redis.
# SHERLOCK_DOCKER_LOG_MAX_SIZE=10m
# SHERLOCK_DOCKER_LOG_MAX_FILES=3
