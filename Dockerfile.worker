# Production image for the Sherlock investigation WORKER (BullMQ consumer).
#
# What this image contains: compiled Sherlock (lib/), git, the Docker CLI,
# Playwright Chromium + native deps, and uv + graphify. What it does NOT
# contain: secrets (provide APP_ID / PRIVATE_KEY[_PATH] / ANTHROPIC_API_KEY /
# REDIS_URL at runtime) and customer repository dependencies (targets are
# cloned and installed inside sibling containers at investigation time).
#
# The worker controls the HOST Docker daemon through a mounted socket
# (-v /var/run/docker.sock:/var/run/docker.sock). Because target containers
# are siblings, any bind-mounted clone path must exist from the DAEMON
# host's perspective — see docs/production-worker.md.

FROM node:22-bookworm-slim

# git for cloning; curl/ca-certificates for the Docker CLI and uv installs.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git \
      ca-certificates \
      curl \
    && rm -rf /var/lib/apt/lists/*

# Docker CLI only — the daemon comes from the mounted host socket.
ARG DOCKER_CLI_VERSION=27.3.1
RUN curl -fsSL "https://download.docker.com/linux/static/stable/$(uname -m)/docker-${DOCKER_CLI_VERSION}.tgz" \
      | tar -xz --strip-components=1 -C /usr/local/bin docker/docker \
    && docker --version

# uv + graphify (graphify is optional at runtime: Sherlock degrades to
# heuristic repository context without it, so a failed install only warns).
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"
RUN uv tool install "graphifyy[anthropic]" \
    || echo "WARN: graphify install failed; the worker will run without graph context"

WORKDIR /app

# Full install (dev deps included) so tsc and the Playwright CLI can run
# during the build; pruned to production deps afterwards.
COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY backend ./backend
COPY src ./src
RUN npm run build

# Playwright Chromium plus its native libraries (the worker runs the
# reproduction browser itself; target apps run in sibling containers).
RUN npx playwright install --with-deps chromium

# Drop build-only dependencies (playwright stays: it is a runtime dep).
RUN npm prune --omit=dev

# Writable application directories; override via ARTIFACTS_DIR /
# SHERLOCK_DATA_DIR (both must be writable — worker:check verifies).
RUN mkdir -p /app/artifacts /data/sherlock
ENV ARTIFACTS_DIR=/app/artifacts
ENV SHERLOCK_DATA_DIR=/data/sherlock
ENV NODE_ENV=production
# Fail fast in production: preflight must pass before jobs are consumed.
ENV SHERLOCK_RUN_STARTUP_CHECKS=true
# This image only ever runs the worker inside a container; the flag makes
# sandbox addressing fail fast (instead of probe timeouts) when the shared
# sandbox network (SHERLOCK_SANDBOX_NETWORK) is not configured.
ENV SHERLOCK_WORKER_CONTAINERIZED=true

CMD ["node", "./lib/backend/worker.js"]
